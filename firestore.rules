rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles - strictly isolated to the user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Links Collection
    match /links/{linkId} {
      // Anyone can resolve a short link or query by code for redirection
      allow read: if true;

      // Anyone can create a link (authenticated users or guest users)
      allow create: if request.resource.data.shortCode is string
                    && request.resource.data.shortCode.size() <= 64
                    && request.resource.data.originalUrl is string
                    && request.resource.data.originalUrl.size() <= 2048
                    && (
                      (request.auth != null && request.resource.data.userId == request.auth.uid)
                      || (request.resource.data.userId == 'guest')
                    );

      // ONLY the authenticated owner can delete their link
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // UPDATE GATES:
      // Gate A: Authenticated link owner can edit original destination URL, title, tags, pause/activate, or expiry
      // Gate B: Authenticated user claiming ownership and/or editing an unclaimed guest link
      // Gate C: Guest creator editing guest link destination/settings without altering shortCode or ownership
      // Gate D: Public visitor click tracking on redirect (strictly restricted to analytics keys)
      allow update: if (
        // Gate A: Owner updating their own link (cannot transfer ownership)
        (request.auth != null && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId)
        ||
        // Gate B: Authenticated user claiming ownership and/or updating an unclaimed guest link
        (request.auth != null && resource.data.userId == 'guest'
          && (request.resource.data.userId == request.auth.uid || request.resource.data.userId == 'guest'))
        ||
        // Gate C: Guest creator updating a guest link (maintains guest ownership & shortCode integrity)
        (resource.data.userId == 'guest'
          && request.resource.data.userId == 'guest'
          && request.resource.data.shortCode == resource.data.shortCode
          && request.resource.data.originalUrl is string
          && request.resource.data.originalUrl.size() <= 2048)
        ||
        // Gate D: Anonymous visitor tracking clicks on short link redirect.
        // HARDENED SECURITY: Only clicks, uniqueVisitors, countries, updatedAt, and shortCodeLower can be touched!
        // Critical settings (isActive, expiresAt, originalUrl, shortCode, userId, title, tags) CANNOT BE MODIFIED!
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'uniqueVisitors', 'countries', 'updatedAt', 'shortCodeLower'])
          && request.resource.data.clicks is number
        )
      );
    }

    // 3. Click Events Collection (Analytics Logs)
    match /click_events/{eventId} {
      // Anyone can record a click event when visiting a short link
      allow create: if request.resource.data.linkId is string
                    && request.resource.data.shortCode is string;

      // Analytics events can ONLY be read by the authenticated link owner
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || resource.data.userId == 'guest'
      );

      // Immutable log - updates and deletions are strictly forbidden
      allow update, delete: if false;
    }

    // Health / connection check path
    match /test/{docId} {
      allow read: if true;
    }
  }
}

