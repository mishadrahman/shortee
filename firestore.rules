rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Links collection
    match /links/{linkId} {
      // Allow getting individual link or querying shortCode for public redirection
      allow get: if true;
      allow list: if (request.auth != null && resource.data.userId == request.auth.uid)
                  || (request.query.limit <= 10);

      // Authenticated user can create link for themselves, or guest without account can create
      allow create: if (
                      (request.auth != null && request.resource.data.userId == request.auth.uid)
                      || (request.resource.data.userId == 'guest')
                    )
                    && request.resource.data.shortCode is string
                    && request.resource.data.originalUrl is string;

      // Link owner can delete
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Owner can update, public visitor can increment clicks, or authenticated user can claim a guest link
      allow update: if (request.auth != null && resource.data.userId == request.auth.uid)
                    || (
                      request.auth != null 
                      && resource.data.userId == 'guest' 
                      && request.resource.data.userId == request.auth.uid
                    )
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'uniqueVisitors', 'updatedAt'])
                    );
    }

    // Click events collection
    match /click_events/{eventId} {
      // Anyone can record a click event upon redirection
      allow create: if true;
      // Authenticated users can view click events for analytics
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Health / connection check path
    match /test/{docId} {
      allow read: if true;
    }
  }
}
