rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Links collection
    match /links/{linkId} {
      // Allow reading any link or listing links
      allow read: if true;

      // Anyone can create a link (authenticated users or guest creators)
      allow create: if request.resource.data.shortCode is string
                    && request.resource.data.originalUrl is string;

      // Link owner can delete
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Owner can update, public visitor can increment clicks, or authenticated user can claim a guest link
      allow update: if true;
    }

    // Click events collection
    match /click_events/{eventId} {
      // Anyone can record and read click events for link analytics
      allow create: if true;
      allow read: if true;
      allow update, delete: if false;
    }

    // Health / connection check path
    match /test/{docId} {
      allow read: if true;
    }
  }
}
